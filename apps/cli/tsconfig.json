{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@hmx/core": ["../../packages/core/src/index.ts"],
      "@hmx/agent-core": ["../../packages/agent-core/src/index.ts"],
      "@hmx/providers": ["../../packages/providers/src/index.ts"],
      "@hmx/router": ["../../packages/router/src/index.ts"],
      "@hmx/media": ["../../packages/media/src/index.ts"],
      "@hmx/dashboard-api": ["../../packages/dashboard-api/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "references": [
    { "path": "../../packages/core" },
    { "path": "../../packages/agent-core" },
    { "path": "../../packages/providers" },
    { "path": "../../packages/router" },
    { "path": "../../packages/media" },
    { "path": "../../packages/dashboard-api" }
  ]
}
